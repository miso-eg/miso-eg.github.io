---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import { categories } from '../data/site';
import { publishedWorks } from '../lib/works';
export function getStaticPaths() { return categories.map(category=>({params:{category:category.slug},props:{category}})); }
const { category } = Astro.props;
let works = (await publishedWorks()).filter(w=>w.data.category===category.slug);
---
<Layout title={category.label} description={category.description}><section class="page-heading wrap"><p class="eyebrow">{category.label}</p><h1>{category.name}</h1><p>{category.description}</p></section><section class="wrap page-content">{category.slug === "gallery" && <aside class="gallery-notice" aria-labelledby="gallery-notice-title"><h2 id="gallery-notice-title">画像の利用について</h2><ul><li>GALLERYに掲載しているすべての画像を、AIの学習に使用することを禁止します。</li><li>「いただきもの」または「依頼作品」のタグが付いた画像は、学習目的以外でも、AIツールへのアップロード・入力などの取り込みを禁止します。</li></ul></aside>}{works.length ? <div class="work-grid">{works.map(work=><WorkCard work={work}/>)}</div> : <div class="empty-state"><span aria-hidden="true">{category.icon}</span><h2>これから、少しずつ。</h2><p>作品を公開したら、ここに追加していきます。</p><a class="text-link" href="/tools/">公開中のツールを見てみる →</a></div>}</section></Layout>

<style>
.gallery-notice { margin-bottom: 28px; padding: 18px 22px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); }
.gallery-notice h2 { margin-bottom: 8px; font-size: 1rem; }
.gallery-notice ul { margin: 0; padding-inline-start: 1.4em; line-height: 1.8; font-size: .9rem; }
</style>
