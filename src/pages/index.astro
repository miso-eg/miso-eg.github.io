---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import { categories, site } from '../data/site';
import { publishedWorks, formatDate, workPath } from '../lib/works';
const works = await publishedWorks();
const tools = works.filter(w => w.data.category === 'tools');
const news = works.filter(w => w.data.category === 'news').sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="dot"></span> MISO'S LITTLE CREATIVE SPACE</p><h1>「好き」のそばで、<br />ちょっと<span class="marker">つくる。</span></h1><p class="hero-description">リス活の中で見つけた、面白そう・役立ちそう。<br class="desktop-break" />その小さなアイデアを、かたちにしています。</p><a class="button" href="/tools/">つくったものを見る <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">みそについて →</a></div>
    <div class="hero-art" aria-hidden="true"><span class="spark spark-one">✳</span><div class="note note-green"><span>little ideas</span><strong>つくる<br />を楽しむ。</strong><span class="note-drawing">✳</span></div><div class="note note-peach"><span>from listener, with love</span><div class="headphones">♫</div><strong>リス活 + creativity</strong></div><span class="spark spark-two">✦</span><span class="art-label">TOOLS · ART · VIDEO · MUSIC</span></div>
  </section>
  <div class="ticker" aria-hidden="true">LISTEN, ENJOY, CREATE. <span>✳</span> 好きからはじまる、ものづくり。 <span>✳</span> LISTEN, ENJOY, CREATE.</div>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">MADE BY MISO</p><h2>リス活に、ひと工夫。</h2></div><a class="text-link" href="/tools/">ツール一覧へ →</a></div><p class="section-intro">ブラウザで使える、自作ツールたち。</p><div class="work-grid">{tools.map(work => <WorkCard work={work} />)}</div></section>
  <section class="about-band wrap"><div class="about-symbol" aria-hidden="true">m<span>✳</span></div><div><p class="eyebrow">HELLO, I'M MISO</p><h2>つくる純リスナー、みそです。</h2><p>{site.description}</p><a class="text-link" href="/about/">プロフィールを見る →</a></div></section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">EXPLORE</p><h2>いろいろ、つくっています。</h2></div></div><div class="category-grid">{categories.filter(c=>c.slug!=='news').map(c=><a class="category" href={`/${c.slug}/`}><span class="category-icon" aria-hidden="true">{c.icon}</span><span><strong>{c.label}</strong><small>{c.name}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
  <section class="section wrap news-section"><div><p class="eyebrow">WHAT'S NEW</p><h2>お知らせ</h2><a class="text-link" href="/news/">すべて見る →</a></div><div class="news-list">{news.length ? news.map(w=><a href={workPath(w.id)}><time datetime={w.data.date.toISOString()}>{formatDate(w.data.date)}</time><span>{w.data.title}</span><span aria-hidden="true">→</span></a>) : <p>お知らせは、これから少しずつ。</p>}</div></section>
</Layout>
