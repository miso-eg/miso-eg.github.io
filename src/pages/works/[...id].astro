---
import { render } from 'astro:content';
import '../../styles/document.css';
import DocumentPages from '../../components/DocumentPages.astro';
import Layout from '../../layouts/Layout.astro';
import { publishedWorks } from '../../lib/works';
import { categories } from '../../data/site';
export async function getStaticPaths() { return (await publishedWorks()).map(work=>({params:{id:work.id},props:{work}})); }
const { work } = Astro.props;
if ((work.data.category === 'tools' || work.data.category === 'line') && work.data.url) {
  return Astro.redirect(work.data.url, 301);
}
const { Content, headings } = await render(work);
const isDocument = work.data.category === 'document';
const category = categories.find(c=>c.slug===work.data.category)!;
---
<Layout title={work.data.title} description={work.data.description}><article class:list={['detail', 'wrap', {'document-detail':isDocument}]}><a class="text-link" href={`/${category.slug}/`}>← {category.name}へ</a><header class="detail-heading"><p class="eyebrow">{category.label}</p><h1>{work.data.title}</h1><p>{work.data.description}</p><div class="tags">{work.data.tags.map(t=><span>{t}</span>)}</div></header>{work.data.image && !work.data.pageImages && <img class="detail-image" src={work.data.image} alt={work.data.imageAlt || work.data.title} />}{work.data.audio && <audio controls preload="none" src={work.data.audio}>お使いのブラウザは音声再生に対応していません。</audio>}{isDocument && <><p class="document-meta">掲載日：{work.data.date.toISOString().slice(0,10)}</p><details class="document-toc" open><summary>目次</summary><ol>{work.data.pageImages ? work.data.pageImages.map((p,i)=><li><a href={`#page-${i+1}`}>{p.title}</a></li>) : headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details></>}<div class:list={['prose', {'document-body':isDocument}]}><Content /></div>{work.data.pageImages && <DocumentPages pages={work.data.pageImages} />}<div class="social-buttons">{work.data.url && <a class="button" href={work.data.url} target="_blank" rel="noopener noreferrer">{work.data.category==='tools' ? 'ツールを開く' : work.data.category==='line' ? 'LINE STOREで見る' : '作品を開く'} ↗</a>}{work.data.repository && <a class="button secondary" href={work.data.repository} target="_blank" rel="noopener noreferrer">GitHubで見る ↗</a>}</div></article></Layout>
