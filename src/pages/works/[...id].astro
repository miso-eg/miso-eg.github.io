---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedWorks, formatDate } from '../../lib/works';
import { categories } from '../../data/site';
export async function getStaticPaths() { return (await publishedWorks()).map(work=>({params:{id:work.id},props:{work}})); }
const { work } = Astro.props;
const { Content } = await render(work);
const category = categories.find(c=>c.slug===work.data.category)!;
---
<Layout title={work.data.title} description={work.data.description}><article class="detail wrap"><a class="text-link" href={`/${category.slug}/`}>← {category.name}へ</a><header class="detail-heading"><p class="eyebrow">{category.label}</p><h1>{work.data.title}</h1><p>{work.data.description}</p><div class="tags">{work.data.tags.map(t=><span>{t}</span>)}</div>{work.data.category==='news' && <time datetime={work.data.date.toISOString()}>{formatDate(work.data.date)}</time>}</header>{work.data.image && <img class="detail-image" src={work.data.image} alt={work.data.imageAlt || work.data.title} />}{work.data.youtubeId && <iframe class="video" src={`https://www.youtube-nocookie.com/embed/${work.data.youtubeId}`} title={work.data.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>}{work.data.audio && <audio controls preload="none" src={work.data.audio}>お使いのブラウザは音声再生に対応していません。</audio>}<div class="prose"><Content /></div><div class="social-buttons">{work.data.url && <a class="button" href={work.data.url} target="_blank" rel="noopener noreferrer">{work.data.category==='tools' ? 'ツールを開く' : '作品を開く'} ↗</a>}{work.data.repository && <a class="button secondary" href={work.data.repository} target="_blank" rel="noopener noreferrer">GitHubで見る ↗</a>}</div></article></Layout>
