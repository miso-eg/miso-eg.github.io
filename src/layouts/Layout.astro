---
import '../styles/global.css';
import '../styles/mobile-fix.css';
import '../styles/character.css';
import { site, categories } from '../data/site';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const pathname = Astro.url.pathname;
const nav = [{slug: '', label: 'HOME'}, {slug: 'about', label: 'PROFILE'}, ...categories];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(pathname, Astro.site)} />
    <meta property="og:title" content={title ? `${title} | ${site.name}` : site.name} />
    <meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(pathname, Astro.site)} />
    <meta name="theme-color" content="#faf7ef" /><link rel="icon" type="image/jpeg" href="/images/miso-illustration.jpg" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="header wrap">
      <a class="brand" href="/" aria-label="みそのホームページ HOME"><img class="brand-character" src="/images/miso-illustration.jpg" alt="" width="52" height="52" /><span>みその<span class="brand-small">ホームページ</span></span></a>
      <details class="mobile-nav"><summary>MENU <span aria-hidden="true">＋</span></summary><nav aria-label="モバイルナビゲーション">{nav.map(item => <a href={`/${item.slug}${item.slug ? '/' : ''}`} aria-current={pathname === `/${item.slug}${item.slug ? '/' : ''}` ? 'page' : undefined}>{item.label}</a>)}</nav></details>
      <nav class="desktop-nav" aria-label="メインナビゲーション">{nav.map(item => <a href={`/${item.slug}${item.slug ? '/' : ''}`} aria-current={pathname === `/${item.slug}${item.slug ? '/' : ''}` ? 'page' : undefined}>{item.label}</a>)}</nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer wrap"><a class="footer-title" href="/">みそのホームページ <span aria-hidden="true">✳</span></a><div class="footer-links">{site.socials.map(s => <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div><small>© {new Date().getUTCFullYear()} miso</small></footer>
  </body>
</html>
